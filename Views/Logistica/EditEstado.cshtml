@model ToyotaLaPaz.Models.DistribucionLogistica

@{
    ViewData["Title"] = "Actualizar Envío / Entrega - Toyota La Paz";
}

<div class="container py-4" style="max-width: 550px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 fw-bold">Actualizar Envío #@Model.LogisticaID</h5>
            <small class="text-secondary">Ruta: @Model.Origen → @Model.Destino</small>
        </div>
        <div class="card-body p-4">
            <form asp-action="EditEstado" method="post">
                <input type="hidden" name="id" value="@Model.LogisticaID" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Estado del Envío (RF26)</label>
                    <select name="estadoEnvio" class="form-select" required>
                        <option value="En ruta" selected="@(Model.EstadoEnvio == "En ruta")">En ruta</option>
                        <option value="Entregado" selected="@(Model.EstadoEnvio == "Entregado")">Entregado (Confirmar recepción)</option>
                        <option value="Retrasado" selected="@(Model.EstadoEnvio == "Retrasado")">Retrasado</option>
                        <option value="Cancelado" selected="@(Model.EstadoEnvio == "Cancelado")">Cancelado</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Fecha y Hora de Entrega Real (RF27)</label>
                    <input type="datetime-local" name="fechaEntregaReal" class="form-control" 
                           value="@(Model.FechaEntregaReal?.ToString("yyyy-MM-ddTHH:mm") ?? DateTime.Now.ToString("yyyy-MM-ddTHH:mm"))" />
                    <div class="form-text">Se guardará automáticamente si seleccionas el estado "Entregado".</div>
                </div>

                <div class="d-flex justify-content-between pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success px-4">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>