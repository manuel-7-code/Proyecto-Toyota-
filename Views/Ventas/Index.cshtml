@model IEnumerable<ToyotaLaPaz.Models.Ventas>

@{
    ViewData["Title"] = "Historial de Ventas - Toyota La Paz";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Historial de Ventas</h2>
            <p class="text-muted small">Registro de operaciones comerciales y facturación</p>
        </div>
        <a asp-action="Create" class="btn btn-danger shadow-sm">+ Nueva Venta</a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">N° Venta</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th>Vehículo (VIN)</th>
                        <th>Método de Pago</th>
                        <th>Monto Total</th>
                        <th>Estado</th>
                        <th>Comprobante</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">#@item.VentaID</td>
                            <td>@item.FechaVenta.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div>@item.Cliente?.Nombre</div>
                                <small class="text-muted">NIT/CI: @item.Cliente?.NitCi</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Vehiculo?.ModeloVehiculo?.NombreModelo</div>
                                <small class="text-muted">VIN: @item.Vehiculo?.VIN</small>
                            </td>
                            <td>@item.MetodoPago</td>
                            <td class="fw-bold text-success">$ @item.MontoTotal.ToString("N2")</td>
                            <td>
                                <span class="badge bg-success">@item.EstadoVenta</span>
                            </td>
                            <td>
                                <a asp-action="Comprobante" asp-route-id="@item.VentaID" class="btn btn-sm btn-outline-dark">
                                    Ver Recibo
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>