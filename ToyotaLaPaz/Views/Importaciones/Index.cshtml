@model IEnumerable<ToyotaLaPaz.Models.ImportacionesVehiculos>

@{
    ViewData["Title"] = "Importación de Vehículos - Toyota La Paz";
    var proveedores = ViewBag.Proveedores as List<ToyotaLaPaz.Models.Proveedores>;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Importación de Vehículos</h2>
            <p class="text-muted small">Control de embarques internacionales, aranceles, aduana y proveedores</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CreateProveedor" class="btn btn-outline-dark">+ Registrar Proveedor )</a>
            <a asp-action="Create" class="btn btn-danger shadow-sm">+ Nueva Importación </a>
        </div>
    </div>

    <!-- Filtro por estado (RF40 / RF43) -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <select name="estado" class="form-select">
                        <option value="">-- Todos los estados de seguimiento --</option>
                        <option value="En tránsito" selected="@(ViewBag.EstadoActual == "En tránsito")">En tránsito marítimo</option>
                        <option value="En Puerto (Arica / Iquique)" selected="@(ViewBag.EstadoActual == "En Puerto (Arica / Iquique)")">En Puerto (Arica / Iquique)</option>
                        <option value="En Aduana La Paz" selected="@(ViewBag.EstadoActual == "En Aduana La Paz")">En Aduana La Paz</option>
                        <option value="Recibido en Aduana / Almacén" selected="@(ViewBag.EstadoActual == "Recibido en Aduana / Almacén")">Recibido en Almacén</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-dark">Filtrar Historial</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Historial de Importaciones (RF43) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 fw-bold">Historial de Importaciones y Embarques</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Proveedor (Origen)</th>
                        <th>Ruta / Puerto Destino</th>
                        <th>Embarque / Llegada Est.</th>
                        <th>Costos (Envío + Arancel)</th>
                        <th>Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">#@item.ImportacionID</td>
                            <td>
                                <div class="fw-semibold">@item.Proveedor?.NombreProveedor</div>
                                <span class="badge bg-light text-dark border">@item.Proveedor?.PaisOrigen</span>
                            </td>
                            <td>@item.PuertoDestino</td>
                            <td>
                                <div class="small">Emb: @item.FechaEmbarque.ToString("dd/MM/yyyy")</div>
                                <div class="small text-muted">Est: @item.FechaEstimadaLlegada.ToString("dd/MM/yyyy")</div>
                                @if (item.FechaRecepcionReal.HasValue)
                                {
                                    <div class="small text-success fw-bold">Recibido: @item.FechaRecepcionReal.Value.ToString("dd/MM/yyyy")</div>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-dark">$us @item.CostoTotalImportacion.ToString("N2")</div>
                                <small class="text-muted">Envío: $@item.CostoTotalEnvio.ToString("N0") | Arancel: $@item.CostoAranceles.ToString("N0")</small>
                            </td>
                            <td>
                                <span class="badge @(item.EstadoSeguimiento == "Recibido en Aduana / Almacén" ? "bg-success" : "bg-warning text-dark")">
                                    @item.EstadoSeguimiento
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    <a asp-action="Seguimiento" asp-route-id="@item.ImportacionID" class="btn btn-sm btn-outline-primary">
                                        Seguimiento / Recepción
                                    </a>
                                    <!-- RF38: Acceso directo a registrar los vehículos físicos que llegaron -->
                                    <a asp-controller="Vehiculos" asp-action="Create" class="btn btn-sm btn-outline-success" title="Registrar unidad en inventario">
                                        + Vehículo
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Directorio de Proveedores (RF36) -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-secondary text-white py-3">
            <h5 class="mb-0 fw-bold">Proveedores Internacionales Registrados </h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Proveedor / Planta</th>
                        <th>País de Origen</th>
                        <th>Contacto</th>
                        <th>Teléfono / Correo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (proveedores != null)
                    {
                        @foreach (var p in proveedores)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">#@p.ProveedorID</td>
                                <td class="fw-semibold">@p.NombreProveedor</td>
                                <td><span class="badge bg-dark">@p.PaisOrigen</span></td>
                                <td>@(p.Contacto ?? "-")</td>
                                <td>@p.Telefono <small class="text-muted">@p.Correo</small></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>