@model ToyotaLaPaz.Models.Empleados

@{
    ViewData["Title"] = "Modificar Empleado - Toyota La Paz";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 fw-bold">Modificar Datos del Empleado</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="EmpleadoID" />
                <input type="hidden" asp-for="Estado" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">Nombre Completo</label>
                    <input asp-for="NombreCompleto" class="form-control" required />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Cédula de Identidad (CI)</label>
                        <input asp-for="CI" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Departamento Asignado</label>
                        <select asp-for="DepartamentoID" class="form-select" asp-items="ViewBag.DepartamentoID" required></select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Cargo</label>
                        <input asp-for="Cargo" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Salario Mensual ($us)</label>
                        <input asp-for="Salario" type="number" step="0.01" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Teléfono</label>
                        <input asp-for="Telefono" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Correo Corporativo</label>
                        <input asp-for="Correo" type="email" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Fecha de Contratación</label>
                    <input asp-for="FechaContratacion" type="date" class="form-control" required />
                </div>

                <div class="d-flex justify-content-between pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger px-4">Actualizar Empleado</button>
                </div>
            </form>
        </div>
    </div>
</div>