@model IEnumerable<ToyotaLaPaz.Models.Rol>

@{
    ViewData["Title"] = "Gestión de Roles - Toyota La Paz";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Gestión de Roles</h2>
            <p class="text-muted small">Administración de perfiles y niveles de acceso</p>
        </div>
        <a asp-action="Create" class="btn btn-danger shadow-sm">+ Registrar Rol</a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Nombre del Rol</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">#@item.RolID</td>
                            <td><span class="badge bg-danger">@item.NombreRol</span></td>
                            <td>@item.Descripcion</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.RolID" class="btn btn-sm btn-outline-dark">Editar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>