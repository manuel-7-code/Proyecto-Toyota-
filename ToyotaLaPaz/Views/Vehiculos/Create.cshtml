@model ToyotaLaPaz.Models.Vehiculo

@{
    ViewData["Title"] = "Registrar Vehículo - Toyota La Paz";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-car-front"></i> Registrar Nuevo Vehículo</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Modelo</label>
                    <select asp-for="ModeloID" class="form-select" asp-items="ViewBag.ModeloID">
                        <option value="">-- Seleccione un Modelo --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">VIN / Chasis</label>
                    <input asp-for="VIN" class="form-control" placeholder="Ej. JTEBU5JR8K5012345" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Número de Motor</label>
                    <input asp-for="Motor" class="form-control" placeholder="Ej. 1GR-FE-98765" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Color</label>
                    <input asp-for="Color" class="form-control" placeholder="Ej. Blanco Perla / Negro Metalizado" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Precio Base ($us)</label>
                    <input asp-for="PrecioBase" class="form-control" type="number" step="0.01" placeholder="Ej. 45000.00" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Estado inicial</label>
                    <select asp-for="EstadoVehiculo" class="form-select">
                        <option value="En Stock">En Stock</option>
                        <option value="En tránsito">En tránsito</option>
                        <option value="En Aduana">En Aduana</option>
                    </select>
                </div>
                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger px-4">Guardar Vehículo</button>
                </div>
            </form>
        </div>
    </div>
</div>