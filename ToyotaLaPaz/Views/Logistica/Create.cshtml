@model ToyotaLaPaz.Models.DistribucionLogistica

@{
    ViewData["Title"] = "Registrar Distribución - Toyota La Paz";
}

<div class="container py-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 fw-bold">Registrar Distribución y Envío</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Vehículo en Stock (VIN)</label>
                    <select asp-for="VehiculoID" class="form-select" asp-items="ViewBag.VehiculoID" required>
                        <option value="">-- Seleccione Vehículo --</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Origen</label>
                        <input asp-for="Origen" class="form-control" value="Almacén Central El Alto" required />
                        <span asp-validation-for="Origen" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Destino </label>
                        <input asp-for="Destino" class="form-control" placeholder="Ej. Showroom Calacoto / Obrajes" required />
                        <span asp-validation-for="Destino" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Fecha de Envío</label>
                        <input asp-for="FechaEnvio" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Fecha Entrega Estimada</label>
                        <input asp-for="FechaEntregaEstimada" type="datetime-local" class="form-control" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Conductor Asignado</label>
                    <input asp-for="ConductorAsignado" class="form-control" placeholder="Ej. Carlos Mamani" />
                </div>

                <div class="d-flex justify-content-between pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger px-4">Registrar Envío</button>
                </div>
            </form>
        </div>
    </div>
</div>