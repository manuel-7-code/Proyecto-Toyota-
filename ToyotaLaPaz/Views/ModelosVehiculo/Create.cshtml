@model ToyotaLaPaz.Models.ModeloVehiculo

@{
    ViewData["Title"] = "Registrar Modelo - Toyota La Paz";
}

<div class="container py-4" style="max-width: 500px;">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="mb-0 fw-bold">Registrar Nuevo Modelo</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Nombre del Modelo</label>
                    <input asp-for="NombreModelo" class="form-control" placeholder="Ej. Hilux, RAV4, Land Cruiser" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Año de Fabricación</label>
                    <input asp-for="Fabricacion" class="form-control" type="number" placeholder="Ej. 2026" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tipo de Vehículo</label>
                    <select asp-for="TipoVehiculo" class="form-select">
                        <option value="SUV">SUV</option>
                        <option value="Camioneta">Camioneta</option>
                        <option value="Sedán">Sedán</option>
                        <option value="Vagoneta">Vagoneta</option>
                        <option value="Comercial">Comercial</option>
                    </select>
                </div>
                <div class="d-flex justify-content-between pt-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger px-4">Guardar Modelo</button>
                </div>
            </form>
        </div>
    </div>
</div>